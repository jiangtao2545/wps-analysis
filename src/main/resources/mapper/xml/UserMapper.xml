<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wps.analysis.mapper.UserMapper">

    <!--
        根据userid列表批量查询login_name（去重）
    -->
    <select id="selectLoginNamesByUserIds" resultType="string">
        SELECT DISTINCT login_name
        FROM `user`
        WHERE userid IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
          AND login_name IS NOT NULL
          AND login_name != ''
    </select>

</mapper>
